<Project>
  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="MongoDB.Bson" Version="2.28.0" />
    <PackageReference Include="FixedMathSharp" Version="1.2.2" />
    <PackageReference Include="xunit" Version="2.9.0" />

    <!--
      ENet. Upstream stopped publishing to NuGet at 2.4.8, so both the managed
      bindings (ENet/ENet.cs, compiled by the default source glob) and the
      native libraries below are vendored from the ENet-CSharp submodule
      instead. These land beside the built assembly, where ENet/ENetNativeResolver.cs
      picks them up; the package's deps.json entries used to do that job. macOS is
      a universal binary, which replaces the old arm64 copy-over-the-x86_64 hack.
      Run native/build-natives.sh to regenerate all four from the submodule.
    -->
    <Content Include="$(MSBuildThisFileDirectory)native\osx\libenet.dylib" Link="enet.dylib"
      CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <Content Include="$(MSBuildThisFileDirectory)native\linux-x64\libenet.so" Link="libenet.so"
      CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <Content Include="$(MSBuildThisFileDirectory)native\win-x64\enet.dll" Link="enet.dll"
      CopyToOutputDirectory="PreserveNewest" Visible="false" />

    <!-- Fody Weavers -->
    <PackageReference Include="Fody" Version="6.8.0" />
    <PackageReference Include="PropertyChanged.Fody" Version="4.1.0" />
    <PackageReference Include="MethodBoundaryAspect.Fody" Version="2.0.149" />

    <!-- Source Generator -->
    <Compile Remove="$(MSBuildThisFileDirectory)Generator\**" />
    <None Remove="$(MSBuildThisFileDirectory)Generator\**" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)Generator\Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="**/*.tscn" />
    <AdditionalFiles Include="project.godot" />
    <!-- Source of the Nebula version folded into the protocol handshake hash -->
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)plugin.cfg" />

    <!-- Shared types -->
    <Compile Include="$(MSBuildThisFileDirectory)Generator\Shared\ProtocolTypes.cs" Link="Nebula\ProtocolTypes.cs" />
  </ItemGroup>

  <PropertyGroup>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
  </PropertyGroup>
  <PropertyGroup>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
</Project>